# Domain (used by Caddy)
# For local development, localhost works without SSL
# For production, set your real domain
DOMAIN=localhost

# Backend secrets
SECRET_KEY=dev-secret-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENROUTER_API_KEY=

# URLs
BACKEND_URL=http://127.0.0.1:5000
FRONTEND_URL=http://127.0.0.1:3000

# Admin credentials (optional)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Email (for password reset)
# Opción recomendada (más segura): service account con domain-wide delegation.
# El backend envía vía Gmail API impersonando EMAIL_SEND_AS, con scope solo-envío.
# GOOGLE_SERVICE_ACCOUNT_FILE=/ruta/fuera-del-repo/service-account.json
# EMAIL_SEND_AS=hola@laia.ar
#
# Opción alternativa: Gmail SMTP con app password de la cuenta:
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=           # opcional, default SMTP_USER
# SMTP_HOST=smtp.gmail.com  # opcional
# SMTP_PORT=465         # opcional
